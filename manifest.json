{
  "manifest_version": 3,
  "name": "YouTube Mark as Watched",
  "version": "0.1.0",
  "description": "Adds a button to YouTube thumbnails to mark videos as watched in native YouTube history.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
